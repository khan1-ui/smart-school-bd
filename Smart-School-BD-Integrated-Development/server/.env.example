NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/smart_school_bd

CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173
# Generate a random secret of at least 32 characters.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# One-time central office account bootstrap (do not commit real credentials).
CENTRAL_OFFICE_NAME=Central Office
CENTRAL_OFFICE_EMAIL=central@example.gov.bd
CENTRAL_OFFICE_PASSWORD=replace_with_a_long_password

# Required to encrypt biometric face descriptors at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FACE_DESCRIPTOR_ENCRYPTION_KEY=replace_with_base64_32_byte_key
